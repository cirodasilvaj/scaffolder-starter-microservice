{
  "overwrite": true,
  "dashboard": {
    "uid": "scaffolder-starter-microservice-dashboard",
    "title": "Service: scaffolder-starter-microservice — Prometheus Metrics & Fluentd/Loki Logs",
    "tags": ["scaffolder-starter-microservice", "prometheus", "loki", "fluentd", "backstage"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "15s",
    "panels": [
      {
        "id": 1,
        "title": "HTTP Requests Total — scaffolder-starter-microservice (Prometheus /metrics)",
        "type": "timeseries",
        "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus-eks" },
        "targets": [
          {
            "expr": "sum by (endpoint) (app_http_requests_total{app=\"scaffolder-starter-microservice\"})",
            "legendFormat": "{{endpoint}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "Service Uptime & CPU Usage — scaffolder-starter-microservice (Prometheus)",
        "type": "timeseries",
        "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus-eks" },
        "targets": [
          {
            "expr": "app_uptime_seconds{app=\"scaffolder-starter-microservice\"}",
            "legendFormat": "uptime (s)"
          },
          {
            "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{pod=~\"scaffolder-starter-microservice.*\",container!=\"\"}[5m]))",
            "legendFormat": "CPU: {{pod}}"
          }
        ]
      },
      {
        "id": 3,
        "title": "Memory Working Set — scaffolder-starter-microservice (Prometheus)",
        "type": "timeseries",
        "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "prometheus-eks" },
        "targets": [
          {
            "expr": "sum by (pod) (container_memory_working_set_bytes{pod=~\"scaffolder-starter-microservice.*\",container!=\"\"})",
            "legendFormat": "{{pod}}"
          }
        ]
      },
      {
        "id": 4,
        "title": "Live Application Logs — scaffolder-starter-microservice (Fluentd -> Loki)",
        "type": "logs",
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 7 },
        "datasource": { "type": "loki", "uid": "loki-eks" },
        "options": {
          "showTime": true,
          "showLabels": true,
          "wrapLogMessage": true,
          "enableLogDetails": true,
          "sortOrder": "Descending"
        },
        "targets": [
          {
            "expr": "{app=\"scaffolder-starter-microservice\"}"
          }
        ]
      }
    ]
  }
}
